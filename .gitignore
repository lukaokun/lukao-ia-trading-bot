*.parquet
*.log
*.log.*
**/trades.*
**/percursos.*
**/relatorio_carteiras.*

# SQLite and other local databases, including WAL/SHM sidecars
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.mdb
*.duckdb
*-wal
*-shm

# Watchlists and on-chain/test fixtures
**/wallet_watchlist*
**/fixtures/
**/fixture/
**/testdata/
**/test_data/

# Backups at any directory depth and editor recovery files
**/.backups/
**/backup/
**/backup*/
**/backup_*/
**/backup-*/
**/backup_*.py
*.bak
*.backup
*.old
*.orig
*~

# User-provided binary assets pending publication rights review
/assets/*
